<view xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://schema.qcadoo.org/view" xsi:schemaLocation="http://schema.qcadoo.org/view http://schema.qcadoo.org/view.xsd" name="employeeDetails" modelName="employee">
    <component type="window" name="window">
        <ribbon>
            <template name="standardFormTemplate"/>
        </ribbon>
        <windowTab name="mainTab" reference="mainTab">
            <component type="form" name="employee" reference="form">
                <component type="gridLayout" name="gridLayout" columns="3" rows="6" hasBorders="true">

                    <layoutElement column="1" row="1">
                        <component type="input" name="number" field="number" reference="number">
                            <option type="alignment" value="right"/>
                        </component>
                    </layoutElement>

                    <!-- First Name -->
                    <layoutElement column="1" row="2">
                        <component type="input" name="firstName" field="firstName" required="true" reference="firstName"/>
                    </layoutElement>

                    <!-- Last Name -->
                    <layoutElement column="1" row="3">
                        <component type="input" name="lastName" field="lastName" required="true" reference="lastName"/>
                    </layoutElement>

                    <!-- Gender -->
                    <layoutElement column="1" row="4">
                        <component type="select" name="gender" field="gender" reference="gender" required="true">
                            <listener event="onInputChange" class="com.qcadoo.mes.rew52.listeners.EmployeeDetailsListeners" method="onGenderChange"/>
                        </component>
                    </layoutElement>

                    <!-- Date of Birth -->
                    <layoutElement column="2" row="1">
                        <component type="calendar" name="dateOfBirth" field="dateOfBirth" required="true" reference="dateOfBirth"/>
                    </layoutElement>

                    <!-- Citizen ID -->
                    <layoutElement column="2" row="2">
                        <component type="input" name="citizenId" field="citizenId" required="true" reference="citizenId"/>
                    </layoutElement>

                    <!-- Email -->
                    <layoutElement column="2" row="3">
                        <component type="input" name="email" field="email" reference="email"/>
                    </layoutElement>

                    <!-- Phone -->
                    <layoutElement column="2" row="4">
                        <component type="input" name="phone" field="phone" reference="phone"/>
                    </layoutElement>

                    <layoutElement column="2" row="5">
                        <component type="file" name="photoPath" field="photoPath">
                            <option type="thumbnail" value="true"/>
                        </component>
                    </layoutElement>

                    <!-- Hire Date -->
                    <layoutElement column="3" row="1">
                        <component type="calendar" name="hireDate" field="hireDate" required="true" reference="hireDate"/>
                    </layoutElement>

                    <!-- Status -->
                    <layoutElement column="3" row="2">
                        <component type="select" name="status" field="status" required="true"/>
                    </layoutElement>

                    <!-- Notes -->
                    <layoutElement column="3" row="3" height="2">
                        <component type="textarea" name="notes" field="notes" reference="notes"/>
                    </layoutElement>

                    <!-- Position -->
                    <layoutElement column="1" row="5">
                        <component type="lookup" name="position" field="position" reference="position" hasDescription="true">
                            <option type="column" name="description" fields="description"/>

                            <option type="searchable" value="name"/>
                            <option type="orderable" value="name"/>
                            <option type="expression" value="#name + ' - ' + #description"/>
                            <option type="fieldCode" value="name"/>
                            <listener event="onSelectedEntityChange" class="com.qcadoo.mes.rew52.listeners.EmployeeDetailsListeners" method="onPositionChange"/>
                            <criteriaModifier class="com.qcadoo.mes.rew52.criteriaModifiers.Rew52EmployeeCriteriaModifiers" method="selectPosition"/>
                        </component>
                    </layoutElement>

                    <!-- Department -->
                    <layoutElement column="1" row="6">
                        <component type="lookup" name="department" field="department" reference="department" hasDescription="true">
                            <option type="column" name="code" fields="code"/>
                            <option type="column" name="parentName" fields="parent" expression="#parent['name']"/>

                            <option type="searchable" value="name,code"/>
                            <option type="orderable" value="name"/>
                            <option type="expression" value="#name + ' - ' + #code"/>
                            <option type="fieldCode" value="name"/>
                            <criteriaModifier class="com.qcadoo.mes.rew52.criteriaModifiers.Rew52EmployeeCriteriaModifiers" method="selectDepartment"/>
                        </component>
                    </layoutElement>

                </component>

                <option type="header" value="true"/>
                <option type="expression" value="'EMP'+ #number + ' - ' + #firstName + ' ' + #lastName"/>
            </component>
        </windowTab>

        <windowTab name="contractTab" reference="contractTab">
            <component type="gridLayout" name="gridLayout" columns="3" rows="1" fixedRowHeight="false">
                <layoutElement column="1" row="1" width="3">
                    <component type="grid" name="employeeContracts" reference="employeeContracts" source="#{form}.employeeContracts">
                        <option type="column" name="number" fields="number" link="true"/>
                        <option type="column" name="contractType" fields="contractType"/>
                        <option type="column" name="startDate" fields="startDate"/>
                        <option type="column" name="endDate" fields="endDate"/>
                        <option type="column" name="basicSalary" fields="basicSalary"/>
                        <option type="column" name="status" fields="status"/>
                        <option type="column" name="signedDate" fields="signedDate"/>
                        <option type="column" name="notes" fields="notes"/>

                        <option type="order" column="number" direction="asc"/>
                        <option type="searchable" value="number,contractType,status"/>
                        <option type="orderable" value="number"/>

                        <option type="correspondingView" value="rew52/contractDetails"/>
                        <option type="correspondingComponent" value="form"/>

                        <option type="fullscreen" value="true"/>
                        <option type="multiselect" value="true"/>
                        <option type="creatable" value="true"/>
                        <option type="deletable" value="true"/>
                        <option type="paginable" value="true"/>
                    </component>
                </layoutElement>
            </component>
        </windowTab>

        <windowTab name="employeeShiftAssignmentTab" reference="employeeShiftAssignmentTab">
            <component type="gridLayout" name="gridLayout" columns="3" rows="1" fixedRowHeight="false">
                <layoutElement column="1" row="1" width="3">
                    <component type="grid" name="employeeShiftAssignments" reference="employeeShiftAssignments" source="#{form}.employeeShiftAssignments">
                        <!-- Các cột hiển thị trong grid -->
                        <option type="column" name="workingShift" fields="workingShift" link="true" expression="#workingShift['name']"/>
                        <option type="column" name="startDate" fields="startDate"/>
                        <option type="column" name="endDate" fields="endDate"/>

                        <!-- Sắp xếp -->
                        <option type="order" column="startDate" direction="desc"/>
                        <option type="searchable" value="shift"/>
                        <option type="orderable" value="startDate,endDate"/>

                        <!-- View khi click vào dòng -->
                        <option type="correspondingView" value="rew52/employeeShiftAssignmentDetails"/>
                        <option type="correspondingComponent" value="form"/>

                        <!-- Tùy chọn hiển thị -->
                        <option type="fullscreen" value="true"/>
                        <option type="multiselect" value="true"/>
                        <option type="creatable" value="true"/>
                        <option type="deletable" value="true"/>
                        <option type="paginable" value="true"/>
                    </component>
                </layoutElement>
            </component>
        </windowTab>

        <windowTab name="absenceTab" reference="absenceTab">
            <component type="gridLayout" name="gridLayout" columns="3" rows="1" fixedRowHeight="false">
                <layoutElement column="1" row="1" width="3">
                    <component type="grid" name="employeeAbsences" reference="employeeAbsences" source="#{form}.employeeAbsences">

                        <!-- Các cột hiển thị trong grid -->
                        <option type="column" name="absenceType" fields="absenceType" link="true"/>
                        <option type="column" name="startDate" fields="startDate"/>
                        <option type="column" name="endDate" fields="endDate"/>
                        <option type="column" name="reason" fields="reason"/>
                        <option type="column" name="status" fields="status"/>

                        <!-- Sắp xếp mặc định -->
                        <option type="order" column="startDate" direction="desc"/>

                        <!-- Tìm kiếm và sắp xếp -->
                        <option type="searchable" value="absenceType,status"/>
                        <option type="orderable" value="startDate,endDate"/>

                        <!-- View khi click vào dòng -->
                        <option type="correspondingView" value="rew52/absenceDetails"/>
                        <option type="correspondingComponent" value="form"/>

                        <!-- Tùy chọn hiển thị -->
                        <option type="fullscreen" value="true"/>
                        <option type="multiselect" value="true"/>
                        <option type="creatable" value="true"/>
                        <option type="deletable" value="true"/>
                        <option type="paginable" value="true"/>
                    </component>
                </layoutElement>
            </component>
        </windowTab>

    </component>
    <hooks>
        <beforeRender class="com.qcadoo.mes.rew52.services.EmployeeService" method="onBeforeRender"/>
    </hooks>
</view>