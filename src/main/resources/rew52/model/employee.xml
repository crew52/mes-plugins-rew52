<?xml version="1.0" encoding="UTF-8"?>

<model name="employee" activable="true" auditable="true" deletable="true"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns="http://schema.qcadoo.org/model"
       xsi:schemaLocation="http://schema.qcadoo.org/model http://schema.qcadoo.org/model.xsd">

    <fields>
        <string name="number" required="true" unique="true">
            <validatesLength max="100"/>
        </string>

        <string name="firstName" required="true">
            <validatesLength max="100"/>
        </string>

        <string name="lastName" required="true">
            <validatesLength max="100"/>
        </string>

        <enum name="gender" values="MALE,FEMALE,OTHER"/>

        <date name="dateOfBirth" required="true">
            <validatesWith class="com.qcadoo.mes.rew52.validators.EmployeeValidators" method="validateAgeBetween18And35"/>
        </date>

        <string name="citizenId" required="true" unique="true">
            <validatesRegex pattern="^0\d{11}$" message="rew52.employee.citizenId.invalid.format"/>
        </string>

        <string name="email" unique="true">
            <validatesLength max="255"/>
            <validatesRegex pattern="^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$" 
                            message="rew52.employee.email.invalid.format"/>
        </string>

        <string name="phone">
            <validatesLength max="50"/>
            <validatesRegex pattern="^0\d{9}$" 
                            message="rew52.employee.phone.invalid.format"/>
        </string>

        <date name="hireDate" required="true">
            <validatesWith class="com.qcadoo.mes.rew52.validators.EmployeeValidators" method="validateHireDateAfter18AndBeforeFuture1Month"/>
        </date>

        <enum name="status" values="ACTIVE,INACTIVE,TERMINATED"/>

        <string name="notes"/>

        <string name="photoPath"/>

        <belongsTo name="position" model="position"/>

        <belongsTo name="department" model="department"/>

    </fields>

    <hooks/>

    <identifier expression="#code + ' - ' + #firstname + ' ' + #lastname"/>
</model>
