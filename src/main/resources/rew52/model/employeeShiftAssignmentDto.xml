<?xml version="1.0" encoding="UTF-8"?>

<model name="employeeshiftassignmentDto" activable="true" auditable="false" deletable="false" insertable="false"
       updatable="false"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schema.qcadoo.org/model"
       xsi:schemaLocation="http://schema.qcadoo.org/model http://schema.qcadoo.org/model.xsd">

    <fields>
        <string name="employeeNumber"/>
        <string name="firstName"/>
        <string name="lastName"/>
        <string name="employeeFullName"/>

        <string name="workingShiftName"/>

        <date name="startDate"/>
        <date name="endDate"/>

        <datetime name="createDate"/>
        <string name="createUser"/>
        <datetime name="updateDate"/>
        <string name="updateUser"/>
    </fields>

    <identifier expression="#employeeFullName + ' - ' + #workingShiftName"/>

    <masterModel plugin="rew52" model="employeeShiftAssignment"/>
</model>