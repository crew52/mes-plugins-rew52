<view xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://schema.qcadoo.org/view" xsi:schemaLocation="http://schema.qcadoo.org/view http://schema.qcadoo.org/view.xsd" name="departmentDetails" modelName="department">
    <component type="window" name="window">
        <ribbon>
            <template name="standardFormTemplate"/>
        </ribbon>
        <component type="form" name="departments" reference="form">
            <component type="gridLayout" name="gridLayout" columns="2" rows="4" hasBorders="true">
                <layoutElement column="1" row="1">
                    <component type="input" name="name" field="name" reference="name" required="true" unique="true"/>
                </layoutElement>
                <layoutElement column="1" row="2">
                    <component type="input" field="code" name="code" reference="code"/>
                </layoutElement>

                <layoutElement column="1" row="3">
                    <component type="lookup" name="parent" field="parent" reference="parent" hasDescription="true">
                        <option type="column" name="code" fields="code"/>
                        <!-- <option type="column" name="parent" fields="parent"/> -->
                        <option type="column" name="parentName" fields="parentName"/>

                        <option type="searchable" value="name,code"/>
                        <option type="orderable" value="name"/>
                        <option type="expression" value="#name + ' - ' + #code"/>
                        <option type="fieldCode" value="name"/>
                        <criteriaModifier class="com.qcadoo.mes.rew52.criteriaModifiers.Rew52DepartmentCriteriaModifiers" method="filterParentDepartments"/>
                    </component>
                </layoutElement>

                <layoutElement column="2" row="1">
                    <component type="input" name="createUser" field="createUser" reference="createUser" defaultEnabled="never"/>
                </layoutElement>
                <layoutElement column="2" row="2">
                    <component type="calendar" name="createDate" field="createDate" reference="createDate" defaultEnabled="never">
                        <option type="withTimePicker" value="true"/>
                    </component>
                </layoutElement>
                <layoutElement column="2" row="3">
                    <component type="input" name="updateUser" field="updateUser" reference="updateUser" defaultEnabled="never"/>
                </layoutElement>
                <layoutElement column="2" row="4">
                    <component type="calendar" name="updateDate" field="updateDate" reference="updateDate" defaultEnabled="never">
                        <option type="withTimePicker" value="true"/>
                    </component>
                </layoutElement>
            </component>
            <option type="header" value="true"/>
            <option type="expression" value="#name"/>
        </component>
    </component>
    <hooks>
        <beforeRender class="com.qcadoo.mes.rew52.services.DepartmentService" method="onBeforeRender"/>
    </hooks>
</view>