<?xml version="1.0" encoding="UTF-8"?>

<model name="employeeShiftAssignment" activable="true" auditable="true" deletable="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://schema.qcadoo.org/model" xsi:schemaLocation="http://schema.qcadoo.org/model http://schema.qcadoo.org/model.xsd">

    <fields>
        <date name="startDate" required="true"/>

        <date name="endDate" required="true"/>

        <belongsTo name="employee" model="employee" required="true"/>

        <belongsTo name="workingShift" model="workingShift" required="true"/>

    </fields>

    <identifier expression="#employee + ' - ' + #workingShift + ' : ' + #startDate"/>

    <hooks>
        <onSave class="com.qcadoo.mes.rew52.hooks.EmployeeShiftAssignmentHooks" method="onSave"/>
    </hooks>
</model>
