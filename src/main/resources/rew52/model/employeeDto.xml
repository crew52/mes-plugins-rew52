<?xml version="1.0" encoding="UTF-8"?>

<model name="employeeDto" activable="true" auditable="false" deletable="false" insertable="false"
       updatable="false"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schema.qcadoo.org/model"
       xsi:schemaLocation="http://schema.qcadoo.org/model http://schema.qcadoo.org/model.xsd">

    <fields>
        <string name="code"/>
        <string name="fullName"/>
        <string name="gender"/>
        <date name="dateOfBirth"/>
        <string name="citizenId"/>
        <string name="email"/>
        <string name="phone"/>
        <date name="hireDate"/>
        <string name="positionName"/>
        <string name="departmentName"/>
        <string name="status"/>
        <string name="photoPath"/>
        <datetime name="createDate"/>
        <string name="createUser"/>
        <datetime name="updateDate"/>
        <string name="updateUser"/>
    </fields>

    <identifier expression="#fullname + ' - ' + #code"/>
    <masterModel plugin="rew52" model="employee"/>
</model>